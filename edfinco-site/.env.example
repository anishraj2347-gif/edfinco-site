# EdFinco website — environment variables.
# Local development: copy to .env.local (git-ignored). Without DATABASE_URL / RESEND_API_KEY the
# site uses an embedded local database (.data/pglite) and saves emails to .data/outbox/.
# Production: set these in Vercel → Project → Settings → Environment Variables. Never commit values.

# Public address of the site (used in emails and links).
APP_URL=https://www.edfinco.com

# Postgres (free): Vercel → Storage → Neon. Use the pooled connection string.
DATABASE_URL=

# The MAIN admin (you). Always has full access and is the only account that can approve new people.
# Everyone else is added in /admin/team and stays pending until the main admin approves them.
MAIN_ADMIN_EMAILS=

# Email (free tier): resend.com → API Keys. EMAIL_FROM must use a domain verified in Resend
# (until then, "EdFinco <onboarding@resend.dev>" can only send to your Resend account's email).
RESEND_API_KEY=
EMAIL_FROM=EdFinco <notifications@edfinco.com>

# The Claude writer (runs on your Claude Pro plan — no API key):
# claude.ai/code/routines → your "EdFinco blog writer" routine → Add API trigger.
ROUTINE_FIRE_URL=
ROUTINE_FIRE_TOKEN=

# Google Sheet copy of consultation requests (tabs "Submitted" and "Partial"):
# paste automation/google-sheet-apps-script.gs into your Sheet → Deploy as web app → copy its URL.
# The secret must be the same long random value as SECRET in that script.
SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_SECRET=

# Shared secret for the hourly scheduler (same value as the GitHub Actions secret CRON_SECRET).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=
